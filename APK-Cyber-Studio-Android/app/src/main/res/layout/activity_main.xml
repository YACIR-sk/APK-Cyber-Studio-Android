<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0B10"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ APK CYBER STUDIO MOBILE"
        android:textColor="#00F0FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="المطور: ياسر بنعيسى | YACIR BEN AISSA"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="/sdcard/APK_Studio/target.apk"
        android:textColorHint="#555555"
        android:textColor="#00FF66"
        android:background="#12141D"
        android:padding="12dp"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="12dp">

        <Button android:id="@+id/btnDecompile" android:text="🔓 تفكيك كامل" android:layout_width="0dp" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnRebuild" android:text="🔒 إعادة بناء" android:layout_width="0dp" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnSign" android:text="🔑 توقيع V1/V2/V3" android:layout_width="0dp" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnInstall" android:text="📲 تثبيت APK" android:layout_width="0dp" android:layout_columnWeight="1" />
    </GridLayout>

    <ScrollView
        android:id="@+id/scrollConsole"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050608"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[SYSTEM] جاهز للتنفيذ...\n"
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
